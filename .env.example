# 播客站自身的公开地址，用于 canonical、详情页和 RSS
PUBLIC_SITE_URL=https://podcast.134688.xyz

# 现有博客站地址，用于原文链接、文章图片和默认内容来源
PUBLIC_BLOG_URL=https://134688.xyz

# R2 公开音频域名；最终对象地址为 {base}/audio/{slug}.mp3
# 不要填带临时签名的 URL，Podcast RSS 需要长期稳定地址
PUBLIC_AUDIO_BASE_URL=https://tel.xx.kg

# 可选：部署时从 GitHub 拉取最新文章；未配置时使用项目内快照
BLOG_REPOSITORY=myogg/astro
BLOG_BRANCH=main
