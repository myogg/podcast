---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EpisodeArchive from "../components/EpisodeArchive.astro";
import { episodesWithAudio, sortEpisodes } from "../lib/episodes";
import "../styles/global.css";

const allEpisodes = sortEpisodes(await getCollection("post"));
const publishable = await episodesWithAudio(allEpisodes);
const pageSize = 40;
const totalPages = Math.ceil(publishable.length / pageSize);
const episodes = publishable.slice(0, pageSize).map(({ episode }) => episode);
const latest = publishable[0]?.episode;
---
<BaseLayout>
  <main>
    <section class="hero">
      <div>
        <div class="eyebrow">姜小小 / Audio Archive</div>
        <h1>把文章，<span>听</span>出来。</h1>
        <p class="hero-copy">这里是姜小小的独立播客站。适合在散步、通勤或夜深之后，换一种方式慢慢听。</p>
        <div class="hero-actions">
          {latest && <a class="button" href={`/podcast/${latest.slug}`}>▶ 听最新一集</a>}
          <a class="button secondary" href="/podcast.xml">订阅 RSS</a>
        </div>
      </div>
      <aside class="signal-card" aria-label="播客介绍">
        <div class="eyebrow">Now recording</div>
        <strong>文字是起点，声音让它继续走。</strong>
        <div class="wave" aria-hidden="true">
          {Array.from({ length: 28 }, (_, i) => <i style={`--h:${18 + ((i * 17) % 38)}px`}></i>)}
        </div>
        <span class="mono episode-count">{publishable.length} 集可收听 / ZH-CN</span>
      </aside>
    </section>

    <section aria-labelledby="latest-heading">
      <div class="section-head">
        <div>
          <h2 id="latest-heading">已生成音频 · 最新节目</h2>
          <p>仅显示音频已就绪的单集，共 {publishable.length} 集，每页 {pageSize} 集</p>
        </div>
        <a class="archive-rss-link" href="/podcast.xml">RSS 中查看全部节目 →</a>
      </div>
      <EpisodeArchive episodes={episodes} page={1} totalPages={totalPages} />
    </section>
  </main>
</BaseLayout>
