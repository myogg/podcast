---
import BaseLayout from "./BaseLayout.astro";
import type { Episode } from "../lib/episodes";
import "../styles/global.css";

interface Props { episode: Episode; audioSize?: number; }
const { episode, audioSize } = Astro.props;
---
<BaseLayout title={`${episode.title} · 134688 播客`} description={episode.description} image={episode.image} type="article">
  <main class="detail-hero">
    <div class="detail-grid">
      <img class="detail-cover" src={episode.image} alt={episode.title} loading="eager" />
      <div>
        <div class="eyebrow">Episode / {episode.slug}</div>
        <h1 class="detail-title">{episode.title}</h1>
        <p class="detail-description">{episode.description}</p>
        <div class="audio-panel">
          <audio controls preload="metadata" src={episode.audioUrl} aria-label={`播放：${episode.title}`}></audio>
          <span class="audio-meta">{audioSize ? `${(audioSize / 1024 / 1024).toFixed(1)} MB` : "R2 音频"}</span>
        </div>
        <a class="source-link" href={episode.originalUrl} target="_blank" rel="noreferrer">在博客阅读原文 ↗</a>
      </div>
    </div>
    <article class="article prose">
      <slot />
    </article>
  </main>
</BaseLayout>
