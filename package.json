{
  "name": "astro-blog-podcast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn new 134688.xyz Astro posts into narrated podcast episodes on Cloudflare Workers and R2.",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply blogcast-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blogcast-db --remote",
    "cron:local": "wrangler dev --test-scheduled"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "typescript": "5.9.3",
    "wrangler": "4.159.0"
  }
}
